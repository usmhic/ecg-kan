# OS / editor
.DS_Store
.idea/
.vscode/
*.code-workspace

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.so

# Virtual environments and local env files
.env
.env.*
.venv/
venv/
env/
ENV/
.python-version

# Test and notebook caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Logs and temp
*.log
*.tmp
*.temp
.tmp/
results/local_run/

# The ECG-ID data itself: download it with the pipeline, never commit it
ecgiddb/
notebook/ecgiddb/

# Pipeline run artefacts. The small metric tables under results/*/metrics/ are
# tracked on purpose (they are the numbers in the paper); the bulky and purely
# regenerable parts are not.
results/*/logs/
results/*/data/

# LaTeX build products (paper/main.tex and paper/figures/ stay tracked)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.xdv
paper/main.pdf
paper/build/
